# Telegram delivery is required in production.
# Development and test environments use a no-op adapter when these are absent.
TELEGRAM_BOT_TOKEN=
GROUP_CHAT_ID=

# Optional timeout in milliseconds. Accepted range: 1000-30000.
TELEGRAM_REQUEST_TIMEOUT_MS=8000

# Test-only safety switch. Telegram is disabled only when this and CI are true.
E2E_DISABLE_TELEGRAM_DELIVERY=false

# Article content source: local, remote, or hybrid.
MDX_CONTENT_SOURCE=local
MDX_REVALIDATE_SECONDS=3600
MDX_REMOTE_BASE_URL=
MDX_REMOTE_TOKEN=

# Remote article request timeout in milliseconds. Accepted range: 100-60000.
MDX_REMOTE_TIMEOUT_MS=10000
